APP_ENV=development
LOG_LEVEL=INFO

# openai | deepseek | mock
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional generic webhook. Empty means console-only notification.
NOTIFY_WEBHOOK_URL=

# Development only. Production must use a real exchange calendar.
ENABLE_SCHEDULER=true
