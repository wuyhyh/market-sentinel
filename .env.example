APP_ENV=development
LOG_LEVEL=INFO

# openai | deepseek | mock
LLM_PROVIDER=mock

# Development only. Production must use a real exchange calendar adapter.
TRADING_CALENDAR=weekday

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional generic webhook. Empty means console-only notification.
NOTIFY_WEBHOOK_URL=

# Use an absolute path when starting outside the project or container working directory.
PORTFOLIO_CONFIG_PATH=config/portfolio.example.yaml
WATCHLIST_CONFIG_PATH=config/watchlist.yaml

ENABLE_SCHEDULER=true
TUSHARE_TOKEN=
SECURITY_MASTER_MAX_AGE_DAYS=7

# Optional local read-only OpenD quote gateway. No login credentials belong here.
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
OPEND_CONNECT_TIMEOUT_SECONDS=2
